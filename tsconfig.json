		"moduleResolution": "bundler",
		"noEmit": true,
		"jsx": "react",
		"lib": ["esnext", "dom"],
		"types": ["react"],
		"skipLibCheck": true,
		"paths": {
			"@ns": ["./NetscriptDefinitions.d.ts"],
